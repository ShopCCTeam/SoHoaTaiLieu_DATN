{
  "name": "sohoatailieu-datn",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "start": "pnpm --filter web start",
    "test": "pnpm --filter web test && pnpm --filter @ctsv/contracts generate",
    "test:e2e": "pnpm --filter web test:e2e",
    "lint": "pnpm --filter web lint && pnpm api:ruff",
    "typecheck": "pnpm --filter web typecheck && pnpm api:mypy",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\" --ignore-path .gitignore",
    "openapi:lint": "redocly lint docs/api/openapi.yaml",
    "openapi:generate": "pnpm --filter @ctsv/contracts generate",
    "api:install": "cd apps/api && uv sync --extra dev",
    "api:test": "cd apps/api && uv run pytest",
    "api:ruff": "cd apps/api && uv run ruff check app tests",
    "api:mypy": "cd apps/api && uv run mypy app",
    "api:dev": "cd apps/api && uv run uvicorn app.main:app --reload --port 8000",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm api:test && pnpm openapi:lint && pnpm build"
  },
  "devDependencies": {
    "@redocly/cli": "^1.25.0",
    "prettier": "^3.9.6"
  }
}
