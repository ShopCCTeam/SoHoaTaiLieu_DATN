# Multi-stage Dockerfile cho FastAPI dev.
# Stage 1: install dependencies với uv.
# Stage 2: copy source (bind mount sẽ override ở docker-compose).

FROM python:3.11-slim AS base

# Cài uv (Astral installer).
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /usr/local/bin/

WORKDIR /app

# Copy package metadata trước để cache layer. `README.md` được khai báo trong pyproject.
COPY pyproject.toml uv.lock* README.md ./

# Install Tesseract fallback and OpenCV runtime libraries required by PaddleOCR.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        tesseract-ocr \
        tesseract-ocr-vie \
        libgl1 \
        libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Install runtime dependencies, including the optional real OCR engines.
RUN uv sync --frozen --no-dev --extra ocr || uv sync --no-dev --extra ocr

# Copy source và migration assets (production image).
# Trong docker-compose dev, volume mount sẽ override source.
COPY app ./app
COPY alembic ./alembic
COPY alembic.ini ./alembic.ini

EXPOSE 8000

# Healthcheck cho container orchestration.
HEALTHCHECK --interval=10s --timeout=3s --retries=5 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health/live')" || exit 1

CMD ["uv", "run", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]