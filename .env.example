# =========================================================
# Environment template — copy thành .env ở root và điền giá trị thật.
# KHÔNG commit .env thật (đã có trong .gitignore).
# =========================================================

# ---- Application ----
APP_ENV=development
APP_LOG_LEVEL=INFO
APP_CORS_ORIGINS=http://localhost:3000

# ---- Postgres (đồng bộ với infra/docker/docker-compose.yml) ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ctsv
POSTGRES_USER=ctsv_app
POSTGRES_PASSWORD=ctsv_dev_password

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0

# ---- MinIO ----
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=ctsv-documents
MINIO_SECURE=false

# ---- Auth ----
# Production: sinh bằng `python -c "import secrets; print(secrets.token_urlsafe(64))"`
JWT_SECRET=dev-only-change-in-production-use-32-plus-bytes
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_TTL_SECONDS=900
JWT_REFRESH_TOKEN_TTL_SECONDS=604800
REFRESH_COOKIE_NAME=rt
REFRESH_COOKIE_PATH=/api/v1/auth
REFRESH_COOKIE_SECURE=false

# ---- OCR ----
OCR_DEFAULT_CONFIDENCE_THRESHOLD=0.9
OCR_DEFAULT_ENGINE=paddleocr
# Bật sau khi so sánh trên corpus cùng baseline 300 DPI; mặc định tắt để không đổi output.
OCR_PREPROCESS_ENABLED=false
OCR_PREPROCESS_DESKEW=true
OCR_PREPROCESS_DENOISE_KERNEL_SIZE=3
OCR_PREPROCESS_BINARIZE=true
OCR_PREPROCESS_ADAPTIVE_THRESHOLD_BLOCK_SIZE=31
OCR_PREPROCESS_ADAPTIVE_THRESHOLD_C=11

# ---- API ----
API_BASE_URL=http://localhost:8000
API_PREFIX=/api/v1

# ---- RAG / Ollama local ----
# Khi API/worker chạy trong Docker Compose, dùng hostname service `ollama`.
EMBEDDING_PROVIDER=mock
EMBEDDING_API_URL=http://localhost:11434/api/embed
EMBEDDING_MODEL_NAME=bge-m3
LLM_PROVIDER=mock
LLM_OLLAMA_BASE_URL=http://localhost:11434
LLM_OLLAMA_MODEL_NAME=qwen2.5:7b
OLLAMA_EMBEDDING_MODEL=bge-m3
OLLAMA_CHAT_MODEL=qwen2.5:7b
OLLAMA_KEEP_ALIVE=5m
