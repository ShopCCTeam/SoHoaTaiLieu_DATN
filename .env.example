# =========================================================
# Environment variables — ví dụ cho môi trường dev
# Copy thành .env và điền giá trị thật. KHÔNG commit .env.
# =========================================================

# ----- Frontend (Next.js) -----
# Mode: "mock" dùng Next.js Route Handlers giả lập. "live" gọi FastAPI thật.
NEXT_PUBLIC_API_MODE=mock
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# ----- Backend (FastAPI) — Phase BE -----
APP_ENV=development
APP_LOG_LEVEL=INFO
APP_CORS_ORIGINS=http://localhost:3000

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ctsv
POSTGRES_USER=ctsv_app
POSTGRES_PASSWORD=change-me

# Redis (Celery broker)
REDIS_URL=redis://localhost:6379/0

# MinIO (S3-compatible)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minio_admin
MINIO_SECRET_KEY=change-me
MINIO_BUCKET_DOCUMENTS=documents
MINIO_BUCKET_DATASETS=datasets
MINIO_BUCKET_MODELS=models
MINIO_SECURE=false

# Ollama (LLM local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=qwen2.5:7b-instruct
OLLAMA_EMBED_MODEL=bge-m3

# JWT
JWT_SECRET=change-me-32-chars-min
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# OCR
OCR_DEFAULT_ENGINE=paddleocr
OCR_FALLBACK_ENGINE=tesseract
OCR_DEFAULT_CONFIDENCE_THRESHOLD=0.9

# RAG
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.6
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=150

# Rate limit
RATE_LIMIT_LOGIN_PER_15MIN=5
RATE_LIMIT_CHAT_PER_MIN=30
RATE_LIMIT_UPLOAD_PER_HOUR=10
